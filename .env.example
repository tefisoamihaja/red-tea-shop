# Copy this file to .env.local and fill in your Supabase project values.
# Supabase dashboard → Project Settings → API (or "Connect" → App Frameworks → Next.js).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) or the legacy "anon" key. Public by design, never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the site (email links, Stripe return pages, sitemap). Optional in dev (defaults to the request host).
# REQUIRED in production.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---

# Supabase secret key (sb_secret_… or legacy service_role): lets the server record paid orders.
# Supabase → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Stripe secret key, TEST mode (sk_test_…): Stripe → Developers → API keys.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…): from `stripe listen` in dev, or Stripe → Developers → Webhooks in production.
# Optional in dev: the success page also records the order.
STRIPE_WEBHOOK_SECRET=
